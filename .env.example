# 이 파일을 .env로 복사해서 값을 채우세요 (.env는 git에 올라가지 않음)
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# Oracle - docker compose가 처음 컨테이너를 만들 때 이 비밀번호로 생성됨
ORACLE_DB_PASSWORD=change-me
ORACLE_USER=system
ORACLE_DSN=localhost:1521/FREEPDB1

# Neo4j - 8자 이상
NEO4J_PASSWORD=change-me-please
NEO4J_USER=neo4j
NEO4J_URI=bolt://localhost:7687

# (선택) claude CLI 위치를 자동으로 못 찾을 때만 지정
# CLAUDE_BIN=
